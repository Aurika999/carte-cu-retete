rules_version = '2';

// Reguli de securitate pentru Firestore (se lipesc în Firebase console → Firestore Database → Rules).
// Fiecare utilizator autentificat poate citi și scrie doar datele lui, din users/<uid>/...
// (ex. meniurile din calendar: users/<uid>/menus/<zi>). Nimeni nu poate vedea datele altcuiva.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
